[TEMPLATE]
# Ember — provider API keys documentation
#
# Copy the variables you need into `.env` (same folder) and restart the
# dev server. Next.js reads .env once at startup, so edits require a
# restart to take effect.
#
# SECURITY
# - .env is gitignored; keys stay on the server.
# - The browser only ever learns WHETHER a key exists (/api/providers),
#   never its value.
# - Each account can also save its OWN provider keys (Settings → Your API
#   keys). Personal keys are used before these shared ones.

# ─────────────────────────────────────────────────────────────────────────
# Auth — required for the landing page / registration / admin flow
# ─────────────────────────────────────────────────────────────────────────
# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every existing session.
# AUTH_SECRET=change-me-to-a-long-random-string

# Emails allowed to sign in as admin using ADMIN_PASSWORD below.
# Comma-separated, e.g. "you@example.com,teammate@example.com".
# "*" means any email may sign in as admin with the password (single-operator
# convenience — set a real address to lock this down).
# ADMIN_EMAILS=you@example.com

# The admin sign-in password (typed where a normal account uses its code).
# ADMIN_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────────────────
# External providers — each key lights up that provider's models instantly
# ─────────────────────────────────────────────────────────────────────────

# OpenRouter — one key, hundreds of models (auto-routing + MiniMax M3…)
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Groq — ultra-low-latency inference (GPT-OSS 120B/20B, Compound)
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Cohere — enterprise models (Command A, Aya Expanse)
# https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=...

# NVIDIA NIM — Nemotron / Llama on accelerated hardware
# https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-...

# G4F — free multi-provider gateway (Gemini flash models)
# G4F_API_KEY=...

# ─────────────────────────────────────────────────────────────────────────
# Optional: custom OpenAI-compatible endpoints
# ─────────────────────────────────────────────────────────────────────────
# Point any provider at a self-hosted / alternative OpenAI-compatible
# gateway (LiteLLM, one-api, Ollama's /v1, …). Trailing slash optional.
# OPENROUTER_BASE_URL=http://localhost:4000/v1
# GROQ_BASE_URL=
# COHERE_BASE_URL=
# NVIDIA_BASE_URL=
# G4F_BASE_URL=
